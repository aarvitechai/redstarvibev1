# Copy to .env, or run `python scripts/bootstrap_env.py` to generate one with fresh secrets.
# Never commit .env. In production use Doppler, Vault or a cloud secret manager.

APP_ENV=local
HTTP_PORT=8080
PUBLIC_URL=
ALLOWED_ORIGINS=http://localhost:8080
COOKIE_SECURE=false

POSTGRES_PASSWORD=
JWT_SECRET=
FIELD_ENCRYPTION_KEY=

# Object storage. Local: SeaweedFS. Production: Cloudflare R2.
S3_ENDPOINT=http://objectstore:9000
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MEDIA_PUBLIC_BASE=/rsv-public

# Calls. Local: LiveKit dev server. Production: LiveKit Cloud (wss://<project>.livekit.cloud).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email. Local: Mailpit at http://localhost:8025. Production: your SMTP provider.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

# Optional integrations. Each feature stays off, or degrades, until its key is set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
SENTRY_DSN=
OTLP_ENDPOINT=
BREACHED_PASSWORD_CHECK=true
CLAMAV_HOST=
ADMIN_IP_ALLOWLIST=
ALLOW_TEST_DATA=false

# Self hosted models. These also need the backend image built with UV_EXTRAS="--extra ai".
EMBEDDING_PROVIDER=hash
CLIP_ENABLED=false
WHISPER_ENABLED=false
